        "        return text\n",
        "\n",
        "    # Otherwise, find the first '{' and last '}' and slice\n",
        "    start = text.find(\"{\")\n",
        "    end = text.rfind(\"}\")\n",
        "    if start == -1 or end == -1 or end <= start:\n",
        "        raise ValueError(f\"No JSON object found in text:\\n{text}\")\n",
        "\n",
